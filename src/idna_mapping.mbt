///|
fn idna_mapping_lookup(cp : Int) -> Array[Int]? {
  let keys = idna_mapping_keys
  let mut lo = 0
  let mut hi = keys.length()
  while lo < hi {
    let mid = (lo + hi) / 2
    let k = keys[mid]
    if cp < k {
      hi = mid
    } else if cp > k {
      lo = mid + 1
    } else {
      return Some(idna_mapping_values[mid])
    }
  }
  None
}
