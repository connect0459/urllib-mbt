    ("redis://foo:bar@somehost:6379/0?baz=bam&qux=baz", None, "null"),
    ("rsync://foo@host:911/sup", None, "null"),
    ("git://github.com/foo/bar.git", None, "null"),
    ("irc://myserver.com:6999/channel?passwd", None, "null"),
    ("dns://fw.example.org:9999/foo.bar.org?type=TXT", None, "null"),
    ("ldap://localhost:389/ou=People,o=JNDITutorial", None, "null"),
    ("git+https://github.com/foo/bar", None, "null"),
    ("urn:ietf:rfc:2648", None, "null"),
    ("tag:joe@example.org,2001:foo/bar", None, "null"),
    ("blob:https://example.com:443/", None, "https://example.com"),
    ("blob:http://example.org:88/", None, "http://example.org:88"),
    ("blob:d3958f5c-0777-0845-9dcf-2cb28783acaf", None, "null"),
    ("blob:", None, "null"),
    ("blob:blob:", None, "null"),
    ("blob:blob:https://example.org/", None, "null"),
    ("blob:about:blank", None, "null"),
    ("blob:ftp://host/path", None, "null"),
    ("blob:ws://example.org/", None, "null"),
    ("blob:wss://example.org/", None, "null"),
    ("blob:http%3a//example.org/", None, "null"),
    (
      "non-special:cannot-be-a-base-url-\u{0000}\u{0001}\u{001F}\u{001E}~\u{007F}\u{0080}",
      None,
      "null",
    ),
    (
      "non-special:cannot-be-a-base-url-!\"$%&'()*+,-.;<=>@[\\]^_`{|}~@/",
      None,
      "null",
    ),
    (
      "https://www.example.com/path{\u{007F}path.html?query'\u{007F}=query#fragment<\u{007F}fragment",
      None,
      "https://www.example.com",
    ),
    (
      "https://user:pass[\u{007F}@foo/bar",
      Some("http://example.org"),
      "https://foo",
    ),
    ("foo:// !\"$%&'()*+,-.;<=>@[\\]^_`{|}~@host/", None, "null"),
    ("wss:// !\"$%&'()*+,-.;<=>@[]^_`{|}~@host/", None, "wss://host"),
    ("foo://joe: !\"$%&'()*+,-.:;<=>@[\\]^_`{|}~@host/", None, "null"),
    ("wss://joe: !\"$%&'()*+,-.:;<=>@[]^_`{|}~@host/", None, "wss://host"),
    ("foo://!\"$%&'()*+,-.;=_`{}~/", None, "null"),
    ("wss://!\"$&'()*+,-.;=_`{}~/", None, "wss://!\"$&'()*+,-.;=_`{}~"),
    ("foo://host/ !\"$%&'()*+,-./:;<=>@[\\]^_`{|}~", None, "null"),
    ("wss://host/ !\"$%&'()*+,-./:;<=>@[\\]^_`{|}~", None, "wss://host"),
    ("foo://host/dir/? !\"$%&'()*+,-./:;<=>?@[\\]^_`{|}~", None, "null"),
    ("wss://host/dir/? !\"$%&'()*+,-./:;<=>?@[\\]^_`{|}~", None, "wss://host"),
    ("foo://host/dir/# !\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~", None, "null"),
    ("wss://host/dir/# !\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~", None, "wss://host"),
    ("https://example.com/\"quoted\"", None, "https://example.com"),
    ("https://a%C2%ADb/", None, "https://ab"),
    ("data://example.com:8080/pathname?search#hash", None, "null"),
    ("data:///test", None, "null"),
    ("data://test/a/../b", None, "null"),
    ("javascript://example.com:8080/pathname?search#hash", None, "null"),
    ("javascript:///test", None, "null"),
    ("javascript://test/a/../b", None, "null"),
    ("mailto://example.com:8080/pathname?search#hash", None, "null"),
    ("mailto:///test", None, "null"),
    ("mailto://test/a/../b", None, "null"),
    ("intent://example.com:8080/pathname?search#hash", None, "null"),
    ("intent:///test", None, "null"),
    ("intent://test/a/../b", None, "null"),
    ("urn://example.com:8080/pathname?search#hash", None, "null"),
    ("urn:///test", None, "null"),
    ("urn://test/a/../b", None, "null"),
    ("turn://example.com:8080/pathname?search#hash", None, "null"),
    ("turn:///test", None, "null"),
    ("turn://test/a/../b", None, "null"),
    ("stun://example.com:8080/pathname?search#hash", None, "null"),
    ("stun:///test", None, "null"),
    ("stun://test/a/../b", None, "null"),
    ("w://x:0", None, "null"),
    ("west://x:0", None, "null"),
    ("android://x:0/a", None, "null"),
    ("drivefs://x:0/a", None, "null"),
    ("chromeos-steam://x:0/a", None, "null"),
    ("steam://x:0/a", None, "null"),
    ("materialized-view://x:0/a", None, "null"),
    ("android-app://x:0", None, "null"),
    ("chrome-distiller://x:0", None, "null"),
    ("chrome-extension://x:0", None, "null"),
    ("chrome-native://x:0", None, "null"),
    ("chrome-resource://x:0", None, "null"),
    ("chrome-search://x:0", None, "null"),
    ("fuchsia-dir://x:0", None, "null"),
    ("isolated-app://x:0", None, "null"),
    ("non-special:\\\\opaque", None, "null"),
    ("non-special:\\\\opaque/path", None, "null"),
    ("non-special:\\\\opaque\\path", None, "null"),
    ("non-special:\\/opaque", None, "null"),
    ("non-special:/\\path", None, "null"),
    ("non-special://host/a\\b", None, "null"),
  ]
  let failures : Array[String] = []
  for item in cases {
    let (input, base_opt, exp_origin) = item
    let base_url : @uri.Url? = match base_opt {
      None => None
      Some(base_str) => Some(@uri.parse(base_str)) catch { _ => None }
    }
    let url = @uri.parse_with_base(input, base_url) catch {
      _ => {
        failures.push("FAIL parse: input=\{input}")
        continue
      }
    }
    if url.origin() != exp_origin {
      failures.push(
        "FAIL origin: input=\{input} got=\{url.origin()} want=\{exp_origin}",
      )
    }
  }
  let n = if failures.length() < 10 { failures.length() } else { 10 }
  for i in 0..<n {
    println(failures[i])
  }
  println(
    "WPT origin: \{cases.length() - failures.length()}/\{cases.length()} passed",
  )
  if failures.length() > 0 {
    println("WARN: \{failures.length()} WPT origin cases failed")
  }
}

///|
test "WPT URL getter: searchParams" {
  let cases : Array[(String, String?, String)] = [
    ("?a=b&c=d", Some("http://example.org/foo/bar"), "a=b&c=d"),
    ("??a=b&c=d", Some("http://example.org/foo/bar"), "%3Fa=b&c=d"),
    ("http:", Some("http://example.org/foo/bar"), ""),
    ("sc:", Some("https://example.org/foo/bar"), ""),
    ("http://foo.bar/baz?qux#foo\u{0008}bar", None, "qux="),
    ("http://foo.bar/baz?qux#foo\"bar", None, "qux="),
    ("http://foo.bar/baz?qux#foo<bar", None, "qux="),
    ("http://foo.bar/baz?qux#foo>bar", None, "qux="),
    ("http://foo.bar/baz?qux#foo\u{0060}bar", None, "qux="),
  ]
  let failures : Array[String] = []
  for item in cases {
    let (input, base_opt, exp_sp) = item
    let base_url : @uri.Url? = match base_opt {
      None => None
      Some(base_str) => Some(@uri.parse(base_str)) catch { _ => None }
    }
    let url = @uri.parse_with_base(input, base_url) catch {
      _ => {
        failures.push("FAIL parse: input=\{input}")
        continue
      }
    }
    let got = url.search_params().to_string()
    if got != exp_sp {
      failures.push(
        "FAIL searchParams: input=\{input} got=\{got} want=\{exp_sp}",
      )
    }
  }
  let n = if failures.length() < 10 { failures.length() } else { 10 }
  for i in 0..<n {
    println(failures[i])
  }
  println(
    "WPT searchParams: \{cases.length() - failures.length()}/\{cases.length()} passed",
  )
  if failures.length() > 0 {
    println("WARN: \{failures.length()} WPT searchParams cases failed")
  }
}
