    ),
    (
      "data:text/plain,test#\u{0000}\u{0001}\t\n\r\u{001F} !\"#$%&'()*+,-./09:;<=>?@AZ[\\]^_`az{|}~\u{007F}\u{0080}\u{0081}\u{00C9}\u{00E9}",
      None,
      "data:",
      "",
      "",
      "",
      "",
      "",
      "text/plain,test",
      "",
      "#%00%01%1F%20!%22#$%&'()*+,-./09:;%3C=%3E?@AZ[\\]^_%60az{|}~%7F%C2%80%C2%81%C3%89%C3%A9",
    ),
    (
      "about:blank#\u{0000}\u{0001}\t\n\r\u{001F} !\"#$%&'()*+,-./09:;<=>?@AZ[\\]^_`az{|}~\u{007F}\u{0080}\u{0081}\u{00C9}\u{00E9}",
      None,
      "about:",
      "",
      "",
      "",
      "",
      "",
      "blank",
      "",
      "#%00%01%1F%20!%22#$%&'()*+,-./09:;%3C=%3E?@AZ[\\]^_%60az{|}~%7F%C2%80%C2%81%C3%89%C3%A9",
    ),
  ]
  let mut passed = 0
  let failures : Array[String] = []
  for item in cases {
    let (
      input,
      base_opt,
      exp_protocol,
      exp_username,
      exp_password,
      exp_hostname,
      exp_host,
      exp_port,
      exp_pathname,
      exp_search,
      exp_hash,
    ) = item
    let base_url : @uri.Url? = match base_opt {
      None => None
      Some(base_str) => Some(@uri.parse(base_str)) catch { _ => None }
    }
    let url = @uri.parse_with_base(input, base_url) catch {
      _ => {
        failures.push("FAIL parse: input=\{input}")
        continue
      }
    }
    let prev_len = failures.length()
    if url.protocol() != exp_protocol {
      failures.push(
        "FAIL protocol: input=\{input} got=\{url.protocol()} want=\{exp_protocol}",
      )
    }
    if url.username != exp_username {
      failures.push(
        "FAIL username: input=\{input} got=\{url.username} want=\{exp_username}",
      )
    }
    if url.password != exp_password {
      failures.push(
        "FAIL password: input=\{input} got=\{url.password} want=\{exp_password}",
      )
    }
    if url.hostname() != exp_hostname {
      failures.push(
        "FAIL hostname: input=\{input} got=\{url.hostname()} want=\{exp_hostname}",
      )
    }
    if url.host_str() != exp_host {
      failures.push(
        "FAIL host: input=\{input} got=\{url.host_str()} want=\{exp_host}",
      )
    }
    if url.port_str() != exp_port {
      failures.push(
        "FAIL port: input=\{input} got=\{url.port_str()} want=\{exp_port}",
      )
    }
    if url.pathname() != exp_pathname {
      failures.push(
        "FAIL pathname: input=\{input} got=\{url.pathname()} want=\{exp_pathname}",
      )
    }
    if url.search() != exp_search {
      failures.push(
        "FAIL search: input=\{input} got=\{url.search()} want=\{exp_search}",
      )
    }
    if url.hash() != exp_hash {
      failures.push(
        "FAIL hash: input=\{input} got=\{url.hash()} want=\{exp_hash}",
      )
    }
    if failures.length() == prev_len {
      passed = passed + 1
    }
  }
  let n = if failures.length() < 10 { failures.length() } else { 10 }
  for i in 0..<n {
    println(failures[i])
  }
  println("WPT getters: \{passed}/\{cases.length()} passed")
  if failures.length() > 0 {
    println("WARN: \{failures.length()} WPT getter assertions failed")
  }
}

///|
test "WPT URL getter: origin" {
  let cases : Array[(String, String?, String)] = [
    (
      "http://example\t.\norg",
      Some("http://example.org/foo/bar"),
      "http://example.org",
    ),
    (
      "http://user:pass@foo:21/bar;par?b#c",
      Some("http://example.org/foo/bar"),
      "http://foo:21",
    ),
    ("https://test:@test", None, "https://test"),
    ("https://:@test", None, "https://test"),
    ("non-special://test:@test/x", None, "null"),
    ("non-special://:@test/x", None, "null"),
    ("http:foo.com", Some("http://example.org/foo/bar"), "http://example.org"),
    (
      "\t   :foo.com   \n",
      Some("http://example.org/foo/bar"),
      "http://example.org",
    ),
    (" foo.com  ", Some("http://example.org/foo/bar"), "http://example.org"),
    ("a:\t foo.com", Some("http://example.org/foo/bar"), "null"),
    (
      "http://f:21/ b ? d # e ",
      Some("http://example.org/foo/bar"),
      "http://f:21",
    ),
    ("http://f:/c", Some("http://example.org/foo/bar"), "http://f"),
    ("http://f:0/c", Some("http://example.org/foo/bar"), "http://f:0"),
    (
      "http://f:00000000000000/c",
      Some("http://example.org/foo/bar"),
      "http://f:0",
    ),
    (
      "http://f:00000000000000000000080/c",
      Some("http://example.org/foo/bar"),
      "http://f",
    ),
    ("http://f:\n/c", Some("http://example.org/foo/bar"), "http://f"),
    ("", Some("http://example.org/foo/bar"), "http://example.org"),
    ("  \t", Some("http://example.org/foo/bar"), "http://example.org"),
    (":foo.com/", Some("http://example.org/foo/bar"), "http://example.org"),
    (":foo.com\\", Some("http://example.org/foo/bar"), "http://example.org"),
    (":", Some("http://example.org/foo/bar"), "http://example.org"),
    (":a", Some("http://example.org/foo/bar"), "http://example.org"),
    (":/", Some("http://example.org/foo/bar"), "http://example.org"),
    (":\\", Some("http://example.org/foo/bar"), "http://example.org"),
    (":#", Some("http://example.org/foo/bar"), "http://example.org"),
    ("#", Some("http://example.org/foo/bar"), "http://example.org"),
    ("#/", Some("http://example.org/foo/bar"), "http://example.org"),
    ("#\\", Some("http://example.org/foo/bar"), "http://example.org"),
    ("#;?", Some("http://example.org/foo/bar"), "http://example.org"),
    ("?", Some("http://example.org/foo/bar"), "http://example.org"),
