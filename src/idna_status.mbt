///|
fn idna_status_code(cp : Int) -> Int {
  let arr = idna_status_table
  let mut lo = 0
  let mut hi = arr.length()
  while lo < hi {
    let mid = (lo + hi) / 2
    let (s, e, c) = arr[mid]
    if cp < s {
      hi = mid
    } else if cp > e {
      lo = mid + 1
    } else {
      return c
    }
  }
  0 // default: valid
}
